# FairRide backend configuration
# Copy this file to .env if you want non-default values:  cp .env.example .env

# Port the backend listens on (frontend expects 3000)
PORT=3000

# PostgreSQL connection string — accounts (name, email, password hash, role)
# are stored here. On Render, paste the Internal Database URL (or, when
# connecting from your own computer, the External Database URL) shown in the
# database's Connect menu.
DATABASE_URL=postgres://user:pass@host:port/db

# Secret used to sign login tokens. Use a long random value, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_super_secret_key

# Note: this app is a matching demo only — no payment processor is
# integrated, and fare amounts are simulated (see calculateFairFare).
